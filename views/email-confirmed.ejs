<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Confirmation – Fabform.io</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    .fade-in { animation: fadeIn 0.9s ease-out forwards; opacity: 0; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
  </style>
</head>

<body class="relative min-h-screen flex items-center justify-center p-6 bg-black">

  <!-- Cinematic background -->
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-600/40 via-purple-600/40 to-pink-500/40 blur-3xl opacity-40"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.10),transparent_70%)]"></div>

  <div class="relative fade-in bg-white/15 backdrop-blur-2xl border border-white/20 shadow-[0_0_60px_rgba(0,0,0,0.35)] rounded-3xl p-14 max-w-xl w-full text-center">

    <% if (success) { %>

      <!-- Success Icon -->
      <div class="flex justify-center mb-10">
        <div class="bg-green-500 shadow-green-500/40 text-white rounded-full p-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <h1 class="text-5xl font-black tracking-tight text-white drop-shadow-xl mb-6">
        Your Email <%= email %> Is Confirmed
      </h1>

      <p class="text-white/90 text-lg leading-relaxed mb-10">
        Your account is now active — welcome aboard.
      </p>

      <a href="https://app.fabform.io/login"
         class="inline-block px-12 py-4 rounded-full bg-white text-indigo-700 font-semibold text-lg shadow-xl hover:shadow-2xl hover:bg-indigo-50 transition-all duration-200">
        Login to Your Account
      </a>

    <% } else { %>

      <!-- Error Icon -->
      <div class="flex justify-center mb-10">
        <div class="bg-red-500 shadow-red-500/40 text-white rounded-full p-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v2m0 4h.01M10.29 3.86l-7.4 12.8A1 1 0 003.76 18h14.48a1 1 0 00.87-1.34l-7.4-12.8a1 1 0 00-1.72 0z" />
          </svg>
        </div>
      </div>

      <h1 class="text-5xl font-black tracking-tight text-white drop-shadow-xl mb-6">
        Email Confirmation Failed
      </h1>

      <p class="text-white/90 text-lg leading-relaxed mb-10">
        This link is invalid, expired, or incomplete.  
        Please request a new verification email.
      </p>

      <a href="https://app.fabform.io/login"
         class="inline-block px-12 py-4 rounded-full bg-white text-indigo-700 font-semibold text-lg shadow-xl hover:shadow-2xl hover:bg-indigo-50 transition-all duration-200">
        Return to Login
      </a>

    <% } %>

  </div>

</body>
</html>

